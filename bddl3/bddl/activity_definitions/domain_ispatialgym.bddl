(define (domain ispatialgym)
    (:requirements :strips :adl)
    (:predicates
        (open ?obj1)
        (ontop ?obj1 ?obj2)
        (nextto ?obj1 ?obj2)
        (under ?obj1 ?obj2)
        (touching ?obj1 ?obj2)
        (inside ?obj1 ?obj2)
        (attached ?obj1 ?obj2)
        (grasped ?agent ?obj)
        (pose_reached ?obj1)
        (pose_settled ?obj1)
        (layout_reached ?obj1)
    )
)
