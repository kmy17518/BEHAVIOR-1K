(define (problem arat_grip_alloy_tube_2_5cm-0)
  (:domain behavior-1k)
  (:objects
    arat_box.n.01_1 - arat_box.n.01
    arat_alloy_tube.n.01_1 - arat_alloy_tube.n.01
    arat_plank.n.01_1 arat_plank.n.01_2 - arat_plank.n.01
    arat_bolt.n.01_1 arat_bolt.n.01_2 - arat_bolt.n.01
    breakfast_table.n.01_1 - breakfast_table.n.01
    agent.n.01_1 - agent.n.01
  )
  (:init
    (inroom breakfast_table.n.01_1 empty_room)
    (open arat_box.n.01_1)
    (ontop arat_box.n.01_1 breakfast_table.n.01_1)
    (ontop arat_plank.n.01_1 arat_box.n.01_1)
    (ontop arat_plank.n.01_2 arat_box.n.01_1)
    (ontop arat_bolt.n.01_1 arat_plank.n.01_1)
    (ontop arat_bolt.n.01_2 arat_plank.n.01_2)
    (ontop arat_alloy_tube.n.01_1 arat_plank.n.01_2)
  )
  ; Completion: the object rests at its ARAT target and the hand has released it.
  ; The 0-3 ARAT score (timing, hand-movement quality) is computed by the scorer layer.
  (:goal
    (and
      (pegged ?arat_alloy_tube.n.01_1 ?arat_bolt.n.01_1)
      (not (touching ?arat_alloy_tube.n.01_1 ?agent.n.01_1))
    )
  )
)
