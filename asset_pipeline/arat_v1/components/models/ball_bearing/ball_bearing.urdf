<?xml version="1.0" ?>
<robot name="ball_bearing">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <mass value="0.0011"/>
      <inertia ixx="6.6e-09" ixy="0" ixz="0" iyy="6.6e-09" iyz="0" izz="6.6e-09"/>
    </inertial>
    <visual name="visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="sphere">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/sphere.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
